{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ashifReza/neuron-reporter/schema/run.schema.json",
  "title": "neuron-reporter run",
  "description": "Input for `neuron-reporter render <file.json>`. Any language can write this file; the CLI turns it into the HTML report. Either this object, or a bare array of nodes.",
  "oneOf": [
    { "$ref": "#/$defs/run" },
    { "type": "array", "items": { "$ref": "#/$defs/node" } }
  ],
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tree"],
      "properties": {
        "name": { "type": "string", "description": "Report and history name" },
        "startedAt": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "description": "Milliseconds" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Pills in the header, e.g. { \"environment\": \"staging\" }" },
        "runInfo": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Rows for the Run details card" },
        "tree": { "type": "array", "items": { "$ref": "#/$defs/node" }, "description": "Top-level nodes are the test cases" }
      }
    },
    "status": { "enum": ["COMPLETED", "FAILED", "WARNED", "PENDING", "SKIPPED"] },
    "node": {
      "type": "object",
      "required": ["description", "status"],
      "properties": {
        "description": { "type": "string" },
        "id": { "type": "string", "description": "A stable identity for run history, so renaming the step keeps its history. Without it a step is known by its path." },
        "status": { "$ref": "#/$defs/status" },
        "duration": { "type": "number", "description": "Milliseconds", "default": 0 },
        "isGroup": { "type": "boolean", "default": false },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" }, "default": [] },
        "error": { "type": "string" },
        "detail": { "type": "string", "description": "Shown under the step whatever its status, e.g. Expected/Actual" },
        "category": { "type": "string", "description": "Override the failure cause key (see classifier rules)" },
        "screenshot": {
          "type": "object",
          "required": ["dataUri"],
          "properties": { "dataUri": { "type": "string" }, "caption": { "type": "string" } }
        },
        "attempts": {
          "type": "array",
          "description": "Every try of a retried step or test; the last one is the final outcome",
          "items": {
            "type": "object",
            "required": ["status"],
            "properties": { "status": { "$ref": "#/$defs/status" }, "duration": { "type": "number" }, "error": { "type": "string" } }
          }
        },
        "flaky": { "type": "boolean", "description": "Failed at least once, then passed on a retry (inferred from attempts when omitted)" },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "contentType": { "type": "string", "description": "e.g. text/plain, text/x-log, application/json, video/webm, image/png, application/zip, text/uri-list" },
              "body": { "type": "string", "description": "Text content" },
              "dataUri": { "type": "string", "description": "Embedded binary content" },
              "path": { "type": "string", "description": "A URL, or a file path relative to this JSON file" }
            }
          }
        }
      }
    }
  }
}
